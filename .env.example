# Copy this to .env and adjust as needed. .env is gitignored.

POSTGRES_USER=automl
POSTGRES_PASSWORD=automl_dev_pw
POSTGRES_DB=automl
POSTGRES_PORT=5433

REDIS_PORT=6380

# --- LLM provider -------------------------------------------------------------
# The stack now calls OpenRouter (OpenAI-compatible) instead of Ollama's
# retired cloud models. Create a key at https://openrouter.ai/keys and paste it
# below, then run your experiments with llm_backend=openai/gpt-oss-120b.
LLM_PROVIDER=openrouter
OPENROUTER_API_KEY=

# Optional overrides:
# OPENROUTER_URL=https://openrouter.ai/api/v1
# To use a local Ollama instead, set LLM_PROVIDER=ollama and point OLLAMA_URL
# at your server (containers reach the host via host.docker.internal):
# OLLAMA_URL=http://host.docker.internal:11434
